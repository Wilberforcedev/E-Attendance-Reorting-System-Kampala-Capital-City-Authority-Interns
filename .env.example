# Node static web server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# PHP API database (set these in the PHP runtime, not in browser code)
COOKIE_SECURE=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ears_db
DB_USER=ears_app
DB_PASSWORD=replace-with-a-secret-from-your-deployment-secret-store
UPLOAD_DIR=/var/lib/ears/uploads

# Generate a unique random value of at least 32 characters for each environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Supply only for the one-time CLI bootstrap; never leave these in the running service.
# BOOTSTRAP_ADMIN_NAME=Administrator Name
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-secret-of-12-or-more-characters
